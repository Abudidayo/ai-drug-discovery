# Copy to .env and fill in. Never commit .env.
# Wrap JSON values in single quotes.

# --- Data sources --------------------------------------------------------------
# fixture | live (run `uv run python -m oxhack_api.prepare` first)
OXHACK_SOURCE=fixture
# fixture | mock | cortex
OXHACK_JURY=fixture
# fixture | vina (needs OXHACK_REPO=postgres; see app/worker/README.md)
# OXHACK_DOCKING=vina

# --- Sessions and rate limits --------------------------------------------------
# Set true behind an HTTPS proxy.
# OXHACK_SESSION_COOKIE_SECURE=true
OXHACK_REQUESTS_PER_MINUTE=240
OXHACK_WRITES_PER_MINUTE=30
OXHACK_MAX_ACTIVE_REQUESTS=32
OXHACK_EXPERIMENTS_PER_HOUR=6
OXHACK_EXPERIMENTS_PER_DAY=100
OXHACK_JURY_PER_HOUR=3
OXHACK_CORTEX_CALLS_PER_MINUTE=12
OXHACK_CORTEX_CALLS_PER_DAY=180

# --- Snowflake Cortex (OXHACK_JURY=cortex) -------------------------------------
# Account is the part before .snowflakecomputing.com; PAT is a programmatic access token.
# Models, e.g. '["openai-gpt-5.4","glm-5.3","kimi-k3"]'
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_MODELS=
SNOWFLAKE_REASONING_EFFORT='{}'

# --- Postgres (optional; memory is the default) --------------------------------
# Migrate first: uv run deploy/db/migrate.py
# OXHACK_REPO=postgres
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
