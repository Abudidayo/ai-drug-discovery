# Copy to .env and fill in. Never commit .env.
# Start the API with it loaded:  cd api && uv run --env-file ../.env uvicorn oxhack_api.app:app
# In a .env file, wrap JSON values in single quotes so their double quotes are kept.

# --- What the API serves ------------------------------------------------------
# fixture (saved sample data, the default) or live (stream A's pipeline with
# stream B's network ranking; run `uv run python -m oxhack_api.prepare` first to
# download the data and build the protein network).
OXHACK_SOURCE=fixture
# Model jury: fixture, mock (practice reviewers, no cost) or cortex (Snowflake).
OXHACK_JURY=fixture
# Binding poses: fixture (made-up scores; the API's default) or vina (real
# AutoDock Vina, run by `python -m oxhack_worker.queue`; needs OXHACK_REPO=postgres,
# DOCKING_VENV and RESULTS_DIR, which the dev container sets). scripts/serve.sh
# uses vina unless this is set. See worker/README.md.
# OXHACK_DOCKING=vina

# --- Anonymous browsers and abuse limits -------------------------------------
# No login. Clearing the browser cookie loses access to its saved history.
# HTTPS automatically sets Secure cookies; serve.sh also requires them in Codespaces.
# Set true behind any other HTTPS reverse proxy. Leave false for local HTTP development.
# OXHACK_SESSION_COOKIE_SECURE=true
OXHACK_REQUESTS_PER_MINUTE=240
OXHACK_WRITES_PER_MINUTE=30
OXHACK_MAX_ACTIVE_REQUESTS=32
OXHACK_EXPERIMENTS_PER_HOUR=6
OXHACK_EXPERIMENTS_PER_DAY=100
OXHACK_JURY_PER_HOUR=3
OXHACK_CORTEX_CALLS_PER_MINUTE=12
OXHACK_CORTEX_CALLS_PER_DAY=180

# --- Snowflake Cortex (only for OXHACK_JURY=cortex) --------------------------
# Account identifier: the part before .snowflakecomputing.com
SNOWFLAKE_ACCOUNT=
# Programmatic access token
SNOWFLAKE_PAT=
# Three model IDs from different families, e.g. '["claude-opus-5-5","openai-gpt-5.4","kimi-k3"]'
SNOWFLAKE_MODELS=
# Optional reasoning effort by model ID, e.g. '{"openai-gpt-5.4":"low"}'
SNOWFLAKE_REASONING_EFFORT='{}'

# --- Saving Experiments in Postgres (optional; memory is the default) --------
# Migrate first: uv run db/migrate.py
# OXHACK_REPO=postgres
# Tiger Cloud service "oxhack" (eu-west-2). Get it with:
#   tiger db uri oxhack --with-password
# DATABASE_URL=postgresql://tsdbadmin:<password>@gqjab0gz4n.i1i7tehdcw.tsdb.cloud.timescale.com:36769/tsdb?sslmode=require
