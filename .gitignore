# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
# Local secrets (see .env.example).
.env

# Downloaded source data (Open Targets, ChEMBL, STRING): cached locally, never committed.
/data/

# Python caches and local virtual environments.
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
